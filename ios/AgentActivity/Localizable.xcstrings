        }
      }
    },
    "No fresh screen image arrived. Open the app to restart screen sharing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未收到新鲜画面。请打开 App，重新授权屏幕共享。"
